<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="fmcomms2_axu4ev_hw"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
fmcomms2_axu4ev_hw
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="fmcomms2_axu4ev_hw">
        <sdx:configuration sdx:name="fmcomms2_axu4ev_hw"
                           sdx:displayName="fmcomms2_axu4ev_hw"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>fmcomms2_axu4ev_hw</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="fmcomms2_axu4ev_hw/boot/fmcomms2_axu4ev_hw.bif"
                            sdx:readme="fmcomms2_axu4ev_hw/boot/generic.readme"
                            sdx:qemuArguments="fmcomms2_axu4ev_hw/qemu/pmu_args.txt:fmcomms2_axu4ev_hw/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="fmcomms2_axu4ev_hw/boot/fmcomms2_axu4ev_hw.bif"
                            sdx:readme="fmcomms2_axu4ev_hw/boot/generic.readme"
                            sdx:qemuArguments="fmcomms2_axu4ev_hw/standalone_domain/qemu/pmu_args.txt:fmcomms2_axu4ev_hw/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="fmcomms2_axu4ev_hw/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="fmcomms2_axu4ev_hw/standalone_domain/bspinclude/include"
                        sdx:bspConfig="fmcomms2_axu4ev_hw/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
